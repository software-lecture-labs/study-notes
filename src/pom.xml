<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lectures</groupId>
    <artifactId>study-notes-snapshots</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Study Notes - Chapter Snapshots</name>
    <description>
        Each module contains the frozen state of the code at the end of the corresponding java-weekN.md file.
        Running "mvn test" will execute the tests for all chapters together.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>6.0.1</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <surefire.version>3.6.0</surefire.version>
    </properties>

    <modules>
        <module>week01-step1-pojo-customer</module>
        <module>week01-step2-immutable-customer</module>
        <module>week02-anemic-model-and-records</module>
        <module>week03-money-and-rich-entity</module>
        <module>week04-aggregate-and-state-machine</module>
        <module>week05-optional-and-stream</module>
        <module>week07-object-creation</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
